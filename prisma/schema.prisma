generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String               @id @default(cuid())
  name                String
  email               String               @unique
  password            String?
  avatar              String?
  role                UserRole             @default(MEMBER)
  status              UserStatus           @default(ACTIVE)
  /// Toggleable product modules for MEMBER accounts (ADMIN ignores; management-only).
  /// Shape: { tasks, docs, research, language, habits, projects, workLogs, reporting }
  enabledModules      Json                 @default("{}")
  baleUserId          String?              @unique
  baleLinkCode        String?
  baleLinkChatId      String?
  baleLinkExpires     DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  accounts            Account[]
  activityLogs        ActivityLog[]
  comments            Comment[]
  notifications       Notification[]
  passwordResetTokens PasswordResetToken[]
  sessions            Session[]
  assignedTasks       Task[]               @relation("TaskAssignedTo")
  createdTasks        Task[]               @relation("TaskCreatedBy")
  teamMembers         TeamMember[]
  projectMembers      ProjectMember[]
  preferences         UserPreferences?
  workLogs            WorkLog[]
  docs                Doc[]
  docFolders          DocFolder[]
  docTags             DocTag[]
  langSessions        LangSession[]
  langProfile         LangProfile?
  langCards           LangCard[]
  langVocabDays       LangVocabDay[]
  langListeningClips  LangListeningClip[]
  examTracks          ExamTrack[]
  mockAttempts        MockAttempt[]
  habits              Habit[]
  areaPreferences     UserAreaPreference[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

model UserPreferences {
  id                        String   @id @default(cuid())
  userId                    String   @unique
  language                  Language @default(FA)
  theme                     Theme    @default(SYSTEM)
  emailNotifs               Boolean  @default(true)
  notifications             Boolean  @default(true)
  soundNotifs               Boolean  @default(false)
  notifyTaskAssigned        Boolean  @default(true)
  notifyTaskUpdated         Boolean  @default(true)
  notifyTaskCommented       Boolean  @default(true)
  notifyMention             Boolean  @default(true)
  notifySprintStarted       Boolean  @default(true)
  notifySprintEnded         Boolean  @default(true)
  notifyDeadlineApproaching Boolean  @default(true)
  notifyStatusChanged       Boolean  @default(true)
  /// Server-local hour (0–23) for the Bale morning digest
  baleDigestHour            Int      @default(8)
  /// Server-local hour (0–23) for the Bale habit nudge
  baleHabitHour             Int      @default(21)
  baleDigestSentOn          String?
  baleHabitSentOn           String?
  /// YYYY-MM-DD for which todayFocusIds apply
  todayFocusDate            String?
  todayFocusIds             String[] @default([])
  /// When set, first-run onboarding tour is complete
  onboardingCompletedAt     DateTime?
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  permissions RolePermission[]
  teamMembers TeamMember[]

  @@map("roles")
}

model Permission {
  id    String           @id @default(cuid())
  key   String           @unique
  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model Organization {
  id      String @id @default(cuid())
  name    String
  ownerId String
  teams   Team[]

  @@map("organizations")
}

model Team {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  description    String?
  projects       Project[]
  members        TeamMember[]
  tasks          Task[]
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@map("teams")
}

model TeamMember {
  id        String   @id @default(cuid())
  teamId    String
  userId    String
  roleId    String
  role      Role     @relation(fields: [roleId], references: [id])
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([teamId, userId])
  @@map("team_members")
}

model Project {
  id          String          @id @default(cuid())
  teamId      String?
  name        String
  description String?
  status      ProjectStatus   @default(ACTIVE)
  area        LifeArea        @default(LIFE)
  /// Pin on hub / Today shortcuts
  pinned      Boolean         @default(false)
  /// Order within an area (lower first); pinned still sorts above
  sortOrder   Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  team        Team?           @relation(fields: [teamId], references: [id], onDelete: SetNull)
  sprints     Sprint[]
  tasks       Task[]
  members     ProjectMember[]
  docs        Doc[]
  langSessions LangSession[]
  langCards   LangCard[]
  langListeningClips LangListeningClip[]
  examTracks  ExamTrack[]
  mockAttempts MockAttempt[]

  @@index([area, pinned, sortOrder])
  @@map("projects")
}

/// Per-user overrides for the four fixed LifeArea buckets (color, icon, order, hide).
model UserAreaPreference {
  id        String   @id @default(cuid())
  userId    String
  area      LifeArea
  /// Preset key (review, orange, …) or #hex
  color     String?
  /// IconName from the UI kit, or emoji string
  icon      String?
  sortOrder Int      @default(0)
  archived  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, area])
  @@map("user_area_preferences")
}

model ProjectMember {
  id        String      @id @default(cuid())
  projectId String
  userId    String
  role      ProjectRole @default(MEMBER)
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())

  @@unique([projectId, userId])
  @@map("project_members")
}

model Sprint {
  id        String       @id @default(cuid())
  projectId String
  goal      String?
  startDate DateTime?
  endDate   DateTime?
  status    SprintStatus @default(PLANNED)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  project   Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks     Task[]

  @@map("sprints")
}

model Task {
  id           String       @id @default(cuid())
  projectId    String?
  sprintId     String?
  parentTaskId String?
  teamId       String?
  title        String
  description  String?
  status       TaskStatus   @default(BACKLOG)
  priority     TaskPriority @default(NONE)
  type         TaskType     @default(TASK)
  storyPoints  Int?
  estimate     Int?
  dueDate      DateTime?
  /// Scheduled length in minutes from dueDate. Null = point-in-time / day-only.
  durationMinutes Int?
  position     Int          @default(0)
  area         LifeArea?
  recurrence   RecurrenceInterval @default(NONE)
  /// Shared id across spawned occurrences of the same series
  recurrenceSeriesId String?
  /// Stop spawning after this date (inclusive of last due)
  recurrenceEndsAt   DateTime?
  createdById  String
  assignedToId String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  attachments  Attachment[]
  checklists   Checklist[]
  comments     Comment[]
  labels       TaskLabel[]
  workLogs     WorkLog[]
  assignedTo   User?        @relation("TaskAssignedTo", fields: [assignedToId], references: [id])
  createdBy    User         @relation("TaskCreatedBy", fields: [createdById], references: [id])
  parent       Task?        @relation("SubTasks", fields: [parentTaskId], references: [id])
  subTasks     Task[]       @relation("SubTasks")
  project      Project?     @relation(fields: [projectId], references: [id])
  sprint       Sprint?      @relation(fields: [sprintId], references: [id])
  team         Team?        @relation(fields: [teamId], references: [id])
  docs         DocTask[]

  @@index([recurrenceSeriesId])
  @@map("tasks")
}

model Label {
  id    String      @id @default(cuid())
  name  String
  color String
  tasks TaskLabel[]

  @@map("labels")
}

model TaskLabel {
  taskId  String
  labelId String
  label   Label  @relation(fields: [labelId], references: [id], onDelete: Cascade)
  task    Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@id([taskId, labelId])
  @@map("task_labels")
}

model Comment {
  id        String   @id @default(cuid())
  taskId    String
  userId    String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])

  @@map("comments")
}

model Attachment {
  id        String   @id @default(cuid())
  taskId    String
  url       String
  filename  String
  createdAt DateTime @default(now())
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@map("attachments")
}

model Checklist {
  id     String          @id @default(cuid())
  taskId String
  title  String
  items  ChecklistItem[]
  task   Task            @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@map("checklists")
}

model ChecklistItem {
  id          String    @id @default(cuid())
  checklistId String
  title       String
  completed   Boolean   @default(false)
  checklist   Checklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)

  @@map("checklist_items")
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String?
  read      Boolean          @default(false)
  data      Json?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model ActivityLog {
  id          String   @id @default(cuid())
  entity      String
  entityId    String
  action      String
  performedBy String
  oldValue    Json?
  newValue    Json?
  timestamp   DateTime @default(now())
  user        User     @relation(fields: [performedBy], references: [id])

  @@map("activity_logs")
}

model WorkLog {
  id          String   @id @default(cuid())
  taskId      String
  userId      String
  hours       Float
  date        DateTime
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("work_logs")
}

enum UserRole {
  ADMIN
  MEMBER
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum TaskStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  REVIEW
  TESTING
  DONE
  BLOCKED
}

enum TaskPriority {
  URGENT
  HIGH
  MEDIUM
  LOW
  NONE
}

enum TaskType {
  TASK
  STORY
  BUG
  EPIC
}

enum SprintStatus {
  PLANNED
  ACTIVE
  COMPLETED
}

enum ProjectStatus {
  ACTIVE
  ARCHIVED
  ON_HOLD
  PLANNED
  COMPLETED
}

enum ProjectRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum NotificationType {
  TASK_ASSIGNED
  TASK_UPDATED
  TASK_COMMENTED
  MENTION
  SPRINT_STARTED
  SPRINT_ENDED
  DEADLINE_APPROACHING
  STATUS_CHANGED
  VOCAB_REVIEW_DUE
}

enum Language {
  EN
  FA
}

enum Theme {
  LIGHT
  DARK
  SYSTEM
}

enum LifeArea {
  PHD
  WORK
  LIFE
  LANG
}

enum RecurrenceInterval {
  NONE
  DAILY
  WEEKLY
  MONTHLY
}

model Habit {
  id           String             @id @default(cuid())
  userId       String
  title        String
  area         LifeArea?
  /// Habits use DAILY (or WEEKLY); NONE means paused
  cadence      RecurrenceInterval @default(DAILY)
  streak       Int                @default(0)
  bestStreak   Int                @default(0)
  lastDoneDate String?
  archivedAt   DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs         HabitLog[]

  @@index([userId, archivedAt])
  @@map("habits")
}

model HabitLog {
  id        String   @id @default(cuid())
  habitId   String
  dateKey   String
  createdAt DateTime @default(now())
  habit     Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@unique([habitId, dateKey])
  @@index([habitId])
  @@map("habit_logs")
}

model Doc {
  id          String     @id @default(cuid())
  title       String     @default("بدون عنوان")
  content     String     @default("") @db.Text
  contentText String     @default("") @db.Text
  area        LifeArea   @default(LIFE)
  status      DocStatus  @default(DRAFTING)
  wordGoal    Int?
  templateKey String?
  systemKey   String?
  pinned      Boolean    @default(false)
  archived    Boolean    @default(false)
  deletedAt   DateTime?
  folderId    String?
  projectId   String?
  userId      String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  folder      DocFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  project     Project?   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  tasks       DocTask[]
  versions    DocVersion[]
  sources     DocSource[]
  quotes      DocQuote[]
  tags        DocTagOnDoc[]

  @@unique([userId, systemKey])
  @@index([userId, updatedAt])
  @@index([userId, area])
  @@index([userId, deletedAt])
  @@index([userId, projectId])
  @@index([folderId])
  @@map("docs")
}

model DocFolder {
  id          String      @id @default(cuid())
  name        String
  description String?     @db.Text
  area        LifeArea?
  userId      String
  parentId    String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent      DocFolder?  @relation("DocFolderTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    DocFolder[] @relation("DocFolderTree")
  docs        Doc[]

  @@index([userId])
  @@map("doc_folders")
}

model DocTag {
  id          String        @id @default(cuid())
  name        String
  description String?       @db.Text
  color       String        @default("#636e87")
  userId      String
  createdAt   DateTime      @default(now())
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  docs        DocTagOnDoc[]

  @@unique([userId, name])
  @@index([userId])
  @@map("doc_tags")
}

model DocTagOnDoc {
  docId String
  tagId String
  doc   Doc    @relation(fields: [docId], references: [id], onDelete: Cascade)
  tag   DocTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([docId, tagId])
  @@map("doc_tags_on_docs")
}

model DocTask {
  docId  String
  taskId String
  doc    Doc  @relation(fields: [docId], references: [id], onDelete: Cascade)
  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@id([docId, taskId])
  @@index([taskId])
  @@map("doc_tasks")
}

model DocVersion {
  id          String   @id @default(cuid())
  docId       String
  title       String
  content     String   @db.Text
  contentText String   @db.Text
  note        String?
  createdAt   DateTime @default(now())
  doc         Doc      @relation(fields: [docId], references: [id], onDelete: Cascade)

  @@index([docId, createdAt])
  @@map("doc_versions")
}

model DocSource {
  id            String              @id @default(cuid())
  docId         String
  title         String
  authors       String?
  url           String?
  year          String?
  doi           String?
  notes         String?             @db.Text
  /// PDF or other file stored via S3 (optional)
  fileUrl       String?
  fileName      String?
  readingStatus SourceReadingStatus @default(TO_READ)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  doc           Doc                 @relation(fields: [docId], references: [id], onDelete: Cascade)
  quotes        DocQuote[]

  @@index([docId])
  @@index([readingStatus])
  @@map("doc_sources")
}

model DocQuote {
  id        String     @id @default(cuid())
  docId     String
  sourceId  String?
  text      String     @db.Text
  note      String?
  createdAt DateTime   @default(now())
  doc       Doc        @relation(fields: [docId], references: [id], onDelete: Cascade)
  source    DocSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  @@index([docId])
  @@map("doc_quotes")
}

enum DocStatus {
  IDEA
  DRAFTING
  REVIEW
  READY
}

enum SourceReadingStatus {
  TO_READ
  READING
  DONE
}

enum LangSkill {
  LISTENING
  READING
  WRITING
  SPEAKING
  GRAMMAR
  VOCAB
  PRONUNCIATION
}

model LangProfile {
  id          String    @id @default(cuid())
  userId      String    @unique
  targetExam  String?
  targetScore String?
  examDate    DateTime?
  weeklyGoalMin Int     @default(210)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("lang_profiles")
}

model LangSession {
  id          String    @id @default(cuid())
  userId      String
  projectId   String?
  skill       LangSkill
  minutes     Int
  note        String?   @db.Text
  practicedAt DateTime  @default(now())
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  project     Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([userId, practicedAt])
  @@index([userId, skill])
  @@index([projectId])
  @@map("lang_sessions")
}

enum ListeningSource {
  YOUTUBE
  AUDIO
}

model LangListeningClip {
  id          String          @id @default(cuid())
  userId      String
  projectId   String?
  title       String
  sourceType  ListeningSource
  /// YouTube id or direct audio URL
  sourceRef   String
  level       String?
  transcript  String?         @db.Text
  notes       String?         @db.Text
  /// Built-in catalog key when installed from starters
  starterKey  String?
  lastPlayedAt DateTime?
  playCount   Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  project     Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([userId, updatedAt])
  @@index([userId, starterKey])
  @@index([projectId])
  @@map("lang_listening_clips")
}

model LangCard {
  id             String    @id @default(cuid())
  userId         String
  projectId      String?
  front          String
  back           String    @db.Text
  example        String?   @db.Text
  tags           String?
  deckKey        String?
  lesson         Int?
  box            Int       @default(0)
  /// null = graduated; 0..n = learning step index
  learningStep   Int?      @default(0)
  intervalDays   Int       @default(0)
  nextReviewAt   DateTime  @default(now())
  lastReviewedAt DateTime?
  reviewCount    Int       @default(0)
  lapses         Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  project        Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([userId, nextReviewAt])
  @@index([userId, projectId])
  @@index([userId, deckKey, lesson])
  @@map("lang_cards")
}

/** One row per local calendar day the user reviewed any vocab card. */
model LangVocabDay {
  id        String   @id @default(cuid())
  userId    String
  /// Start of local day (UTC-stored midnight of that local day).
  day       DateTime
  reviews   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, day])
  @@index([userId, day])
  @@map("lang_vocab_days")
}

enum ExamKind {
  MSRT
  IELTS
  TOEFL
  TOLIMO
  EPT
  CUSTOM
}

enum MockStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

model ExamTrack {
  id          String        @id @default(cuid())
  userId      String
  projectId   String?
  kind        ExamKind      @default(MSRT)
  name        String
  targetScore String?
  examDate    DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  project     Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  mocks       MockAttempt[]

  @@index([userId, kind])
  @@index([userId, projectId])
  @@map("exam_tracks")
}

model MockAttempt {
  id          String     @id @default(cuid())
  userId      String
  trackId     String
  projectId   String?
  kind        ExamKind
  status      MockStatus @default(IN_PROGRESS)
  startedAt   DateTime   @default(now())
  finishedAt  DateTime?
  durationSec Int?
  totalCorrect Int?
  totalQuestions Int?
  percent     Float?
  sections    Json       @default("[]")
  note        String?    @db.Text
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  track       ExamTrack  @relation(fields: [trackId], references: [id], onDelete: Cascade)
  project     Project?   @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([userId, startedAt])
  @@index([trackId, startedAt])
  @@map("mock_attempts")
}

/// Singleton row (`id = "default"`). Empty token falls back to BALE_BOT_TOKEN.
model BaleConfig {
  id               String   @id @default("default")
  enabled          Boolean  @default(false)
  botToken         String   @default("")
  baseUrl          String   @default("https://tapi.bale.ai/bot")
  adminChatId      String   @default("")
  tasksChannelId   String   @default("")
  notifyChannel    Boolean  @default(true)
  notifyCreated    Boolean  @default(true)
  notifyUpdated    Boolean  @default(true)
  notifyStatus     Boolean  @default(true)
  notifyAssigned   Boolean  @default(true)
  notifyComment    Boolean  @default(true)
  notifyWorkLog    Boolean  @default(true)
  notifyDeadline   Boolean  @default(true)
  notifyVocab      Boolean  @default(true)
  notifyDmAssigned Boolean  @default(true)
  notifyDmStatus   Boolean  @default(true)
  notifyDmComment  Boolean  @default(true)
  notifyDueChange  Boolean  @default(true)
  notifyDigest     Boolean  @default(true)
  notifyHabits     Boolean  @default(true)
  updatedAt        DateTime @updatedAt

  @@map("bale_config")
}

model BaleDelivery {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  kind      String
  chatId    String
  ok        Boolean
  error     String?
  preview   String   @default("")

  @@index([createdAt])
  @@map("bale_deliveries")
}

model BaleOutbound {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  chatId    String
  messageId Int
  taskId    String
  kind      String

  @@index([chatId, messageId])
  @@map("bale_outbound")
}
