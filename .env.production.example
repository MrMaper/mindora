# Production template for Mindora on VPS — copy to .env on the server.
# Do NOT commit real secrets.

AUTH_SECRET=CHANGE_ME_openssl_rand_base64_32

NEXT_PUBLIC_APP_URL=https://mindoraos.ir
APP_URL=https://mindoraos.ir

POSTGRES_USER=mindora
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
POSTGRES_DB=mindora

# Seed once on first boot, then keep DISABLE_DB_SEED=1
DISABLE_DB_SEED=1

# Optional
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=

BALE_BASE_URL=
BALE_BOT_TOKEN=
BALE_ADMIN_CHAT_ID=
